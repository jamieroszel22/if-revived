---
import { SITE } from '../lib/site';
import { passageSource, type Chapter } from '../lib/chapters';

interface Props {
  entry: Chapter;
}

const { entry } = Astro.props;
const { authorship, signature, versions, process, release } = entry.data;

const source = passageSource(entry);
const currentVersion = versions.length > 0 ? versions.length : 1;
const releaseDate = release === 'draft' ? '' : release.toISOString().slice(0, 10);
const fmt = (date: Date) => date.toISOString().slice(0, 10);

/*
  The passage travels as JSON and is parsed back, so the browser hashes the
  text itself. Carried as HTML text an apostrophe would arrive as &#39; and
  every signed passage containing one would fail its own check.

  `<` is escaped so the payload cannot close this script element early.
*/
const sourceJson = JSON.stringify(source).replace(/</g, '\\u003c');
---

<!--
  Verify is a drawer on the passage, never a page, and always opt-in. Nothing
  on the site requires it.
-->
<details
  class="verify"
  data-verify
  data-authorship={authorship}
  data-version={String(currentVersion)}
  data-date={releaseDate}
  data-signature={signature ?? ''}
  data-public-key={SITE.publicKey}
>
  <summary>Verify</summary>

  <div class="verify-body">
    <div class="verify-row">
      <span class="verify-key">Label</span>
      <span class="verify-value">{authorship}</span>
    </div>

    <div class="verify-row">
      <span class="verify-key">Version</span>
      <span class="verify-value">{currentVersion}</span>
    </div>

    {
      releaseDate && (
        <div class="verify-row">
          <span class="verify-key">Date</span>
          <span class="verify-value">{releaseDate}</span>
        </div>
      )
    }

    <div class="verify-row">
      <span class="verify-key">Signature</span>
      <span class="verify-value is-string">{signature ?? 'Not signed yet.'}</span>
    </div>

    {
      versions.length > 1 && (
        <div class="verify-row">
          <span class="verify-key">Versions</span>
          <ul class="verify-versions verify-value">
            {versions
              .slice()
              .reverse()
              .map((v) => (
                <li>
                  <span>{fmt(v.date)} · {v.label}</span>
                  {v.signature && (
                    <div class="verify-key is-string">{v.signature}</div>
                  )}
                </li>
              ))}
          </ul>
        </div>
      )
    }

    {
      process && (
        <div class="verify-row">
          <span class="verify-key">Process note</span>
          <p class="verify-note verify-value">{process}</p>
        </div>
      )
    }

    <div class="verify-row">
      <span class="verify-key">Check</span>
      <span class="verify-value">
        <button type="button" data-verify-run>Check signature</button>
        <span class="verify-key" data-verify-result role="status"></span>
      </span>
    </div>

    <p class="verify-scope">
      A signature proves this text and this label have not changed since Jamie
      signed them. It cannot prove who typed the words.
    </p>

    <script
      type="application/json"
      data-passage-source
      set:html={sourceJson}
    />
  </div>
</details>

<script>
  import '../scripts/verify.js';
</script>
