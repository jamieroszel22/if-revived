---
import { noise, slotLabel } from '../lib/chapters';

interface Props {
  index: number;
}

const { index } = Astro.props;

/*
  The next slot, and only the next one. An index, never a total. No target
  address and no timestamp: a header would give away where this one goes.

  Drawn here so a reader without JavaScript still sees noise, and drawn again
  on load so it is not the same string every visit. It is not the chapter
  encrypted — that would commit to text that is still allowed to change — and
  its length says nothing about the real length.
*/
const string = noise();
---

<div class="noise-slot">
  <span class="noise-index" aria-hidden="true">{slotLabel(index)}</span>
  <span class="noise-string" data-noise aria-hidden="true">{string}</span>
  <span class="visually-hidden">Slot {slotLabel(index)} is not readable yet.</span>
</div>

<script>
  import '../scripts/noise-slot.js';
</script>
