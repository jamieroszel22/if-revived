---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ChunkLines from '../../components/ChunkLines.astro';
import VerifyDrawer from '../../components/VerifyDrawer.astro';
import {
  releasedChapters,
  slotLabel,
  firstLine,
  type Chapter,
} from '../../lib/chapters';

interface Props {
  entry: Chapter;
  previous?: Chapter;
  next?: Chapter;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const chapters = await releasedChapters();

  return chapters.map((entry, i) => ({
    params: { slot: slotLabel(entry.data.slot) },
    props: {
      entry,
      previous: chapters[i - 1],
      next: chapters[i + 1],
    },
  }));
};

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const heading = firstLine(entry);
---

<Base title={heading} heading={heading}>
  {
    entry.data.placeholder && (
      <p class="placeholder-note">
        Placeholder text. This stands in for the chapter so the site can be
        built and read through; it is not the book.
      </p>
    )
  }

  <article>
    {
      entry.data.surface === 'chunk' ? (
        <ChunkLines entry={entry} />
      ) : (
        <div class="prose">
          <Content />
        </div>
      )
    }

    <!-- The hook that nothing fills. It is a line, not a feature. -->
    <p class="hook" aria-hidden="true"></p>
  </article>

  <VerifyDrawer entry={entry} />

  <nav class="chapter-nav" aria-label="Reading order">
    {previous ? (
      <a href={`/read/${slotLabel(previous.data.slot)}/`} rel="prev">Previous</a>
    ) : (
      <span />
    )}
    {next ? (
      <a href={`/read/${slotLabel(next.data.slot)}/`} rel="next">Next</a>
    ) : (
      <span />
    )}
  </nav>

  <script>
    import '../../scripts/board-text.js';
  </script>
</Base>
