---
import '../styles/global.css';
import { SITE } from '../lib/site';

interface Props {
  /** Page title. Chapters use their first line; nothing is invented. */
  title?: string;
  /**
   * The page's one h1. On the stem that is the site title, shown. Everywhere
   * else it is this heading, which is there for structure rather than
   * decoration, so it is hidden unless a page asks for it.
   */
  heading?: string;
  headingVisible?: boolean;
  /** Says what the site is. Never what the book is about. */
  description?: string;
  /** The stem shows the title as plain text rather than a link to itself. */
  home?: boolean;
}

const {
  title,
  heading,
  headingVisible = false,
  description,
  home = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang="en" data-plain="false">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {!SITE.indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- The two faces used above the fold on every page. -->
    <link
      rel="preload"
      href="/fonts/newsreader-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Set before first paint, so the switch does not flash off and on. -->
    <script is:inline>
      try {
        var stored = localStorage.getItem('ifrevived:plain');
        document.documentElement.dataset.plain =
          stored === 'true' ? 'true' : 'false';
      } catch (error) {
        /* Storage blocked. The switch still works for this page. */
      }
    </script>
  </head>

  <body>
    <div class="page">
      <header>
        {
          home ? (
            <h1 class="site-title">{SITE.title}</h1>
          ) : (
            <p class="site-title">
              <a href="/">{SITE.title}</a>
            </p>
          )
        }
      </header>

      <main>
        {
          !home && heading && (
            <h1 class={headingVisible ? 'page-heading' : 'visually-hidden'}>
              {heading}
            </h1>
          )
        }
        <slot />
      </main>
    </div>

    <footer class="site-foot">
      <a href="/about/">About</a>
      <label class="plain-switch">
        <input type="checkbox" data-plain-switch />
        Plain text
      </label>
    </footer>

    <script>
      import '../scripts/plain-switch.js';
    </script>
  </body>
</html>
